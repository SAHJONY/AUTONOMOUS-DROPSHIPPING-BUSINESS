# ============================================================================
# BOTANICA OCHOSI Commerce OS — environment configuration
# ============================================================================
# The production app is the Vercel-native Next.js app in apps/web. Set these
# in the Vercel project (Settings → Environment Variables). The legacy FastAPI
# service in apps/api reads the same ANTHROPIC_* / SECRET_KEY vars for local dev.

# --- The brain (OpenAI / Codex) ---------------------------------------------
# Without a key the app runs in deterministic SIMULATION mode (fully usable).
# Set the key to activate the live autonomous brain and engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- Security ----------------------------------------------------------------
# JWT signing secret for the Next.js auth. MUST be a long random value in prod.
JWT_SECRET=change-me-to-a-long-random-string
SECRET_KEY=change-me-in-production        # legacy FastAPI fallback

# The owner account's password. This is the ONLY way the owner account comes to
# exist: /api/auth/register refuses the owner email on purpose, so with this
# unset there is no way to sign in and therefore no approvals, no store
# connection, and no way to run the business. Set it before the first deploy.
# The owner email is fixed in lib/config.ts and is not an env var.
OWNER_PASSWORD=

# --- Storage (Upstash Redis) -------------------------------------------------
# When these are set the app persists 24/7 to Upstash; otherwise it uses an
# in-memory fallback (data resets on cold starts). Vercel's Upstash marketplace
# integration also provides KV_REST_API_URL / KV_REST_API_TOKEN, both accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Autonomous cron ---------------------------------------------------------
# Secret that authorizes /api/cron/autonomous and /api/cron/fulfillment. Vercel
# Cron sends it as a Bearer token automatically when set on the project.
CRON_SECRET=

# --- Master safety gates -----------------------------------------------------
# Leave both false until security, commerce-safety, and accounting releases have
# passed their production gates. While ENABLE_AUTONOMY is false the business will
# not auto-approve, auto-publish, or spend a cent at the supplier.
ENABLE_AUTONOMY=false
COMMERCE_RELEASE_ENABLED=false

# --- Order feed (Shopify webhooks) -------------------------------------------
# Shopify signs every webhook with your app's client secret. Without this value
# webhook deliveries are REJECTED, and the app falls back to polling Shopify on
# the hourly fulfillment cron. Set both of these to get real-time orders.
SHOPIFY_WEBHOOK_SECRET=
# Public origin used to register webhook callbacks. On Vercel production this is
# inferred from VERCEL_PROJECT_PRODUCTION_URL; set it explicitly for a custom domain.
PUBLIC_BASE_URL=

# --- BOTANICA OCHOSI email (Resend) -----------------------------------------
# Verify botanicaochosi.com in Resend before using this production sender.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOTANICA_EMAIL_FROM=BOTANICA OCHOSI <suppliers@botanicaochosi.com>
BOTANICA_EMAIL_REPLY_TO=suppliers@botanicaochosi.com
# Organization that owns inbound supplier mail. Copy the real Owner OS org ID.
BOTANICA_EMAIL_ORG_ID=
AUTONOMOUS_EMAIL_RESPONSES=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
# Owner-only private chat ID accepted by the command webhook.
TELEGRAM_OWNER_CHAT_ID=

# --- Fulfillment & spending limits -------------------------------------------
# Buying goods from the supplier is the only autonomous action that spends real
# cash, so it has its own controls.
AUTO_FULFILL=false                 # place paid orders with the supplier automatically
                                   # (also requires ENABLE_AUTONOMY=true above)
AUTOPILOT_MAX_ORDER_COST=100       # orders costing more than this wait for the owner.
                                   # Hard-capped at 100 in lib/config.ts during the lean
                                   # launch — a higher value here is clamped, not honoured.
HOLD_RISKY_ORDERS=true             # hold orders Shopify flags as fraud risk

# --- Accounting --------------------------------------------------------------
# Shopify's order payload omits the processing fee, so the books model it.
# Match these to your actual processor agreement.
PAYMENT_FEE_RATE=0.029
PAYMENT_FEE_FIXED=0.30

# --- Product intelligence ----------------------------------------------------
LAUNCH_SCORE_THRESHOLD=85

# --- Autonomous intelligence sweep -------------------------------------------
# Runs every tick: joins the 25-SKU sourcing basket against the live catalog and
# files the gap into business memory. Deterministic and free.
AUTONOMY_COMPETITOR_SCAN_LIMIT=10  # competitor listings re-priced per org per tick
# NBD customs/trade lookups per org per tick. This is the only PAID call in the
# sweep. A supplier is looked up once and then remembered, so the steady state is
# zero calls; set to 0 to disable it outright. Skipped entirely without a key.
AUTONOMY_TRADE_LOOKUPS=2
NBD_RAPIDAPI_KEY=

# --- MCP server (Accio Work and other desktop MCP clients) --------------------
# Publishes /api/mcp so Accio Work can pull the sourcing gap and file the
# suppliers it finds — Accio does the searching on its free tier, which is the
# alternative to paying for the web-search provider below.
# Fail-closed: without the token the endpoint returns 503. MCP_ORG_ID is
# optional — with exactly one organization it is detected automatically, and
# with several the server refuses and names them rather than guessing.
# The exposed tools are read + candidate intake only. No supplier orders, no
# publishing, no refunds, no ad budgets — pinned by tests/mcp.test.ts.
MCP_ACCESS_TOKEN=
MCP_ORG_ID=

# --- Autonomous supplier discovery (open-web search) --------------------------
# OFF until a provider key is set. Finds suppliers for the SKUs the catalog is
# missing, files candidates under supplier-candidate:{host}, and never contacts
# anyone. Candidates are unverified web results, not vetted suppliers.
#
# Neither provider caps your spending, so the app enforces its own ceiling:
#   Brave      — free tier ended Feb 2026. $5/1k queries past a $5 monthly
#                credit, billed with NO spending cap.
#   Google CSE — 100 queries/day free, but closed to new customers and
#                retiring 2027-01-01.
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Platform-wide hard ceiling on paid queries per UTC day. 0 disables discovery.
# At the default, worst case on Brave is about $0.25/day.
SUPPLIER_DISCOVERY_DAILY_BUDGET=50
SUPPLIER_DISCOVERY_QUERIES_PER_TICK=2

# --- Legacy FastAPI (apps/api) local dev only -------------------------------
# DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce_os
