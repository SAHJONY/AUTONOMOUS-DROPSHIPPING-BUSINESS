# Claude Commerce OS configuration

# Security — change in production
SECRET_KEY=change-me-in-production

# Database (defaults to local SQLite for development)
# DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce_os

# Anthropic API — required for live agent runs
ANTHROPIC_API_KEY=
